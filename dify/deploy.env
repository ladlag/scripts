# =============================================================================
# deploy.env — Dify 生产环境变量示例配置
#
# 使用说明
# --------
#   1. 将本文件复制为 deploy.env，并按实际环境填写各项值。
#   2. 本文件会被 dify_deploy.sh 自动加载；请勿将含真实密钥的文件提交到版本控制。
#   3. 标注 [必填] 的项目必须在部署前设置；[可选] 项目有合理默认值。
#   4. 多机部署时，所有节点须使用同一份 deploy.env（或保持密钥变量完全一致）。
#
# 密钥生成参考命令
# ----------------
#   SECRET_KEY:       openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -base64 24
#   REDIS_PASSWORD:    openssl rand -base64 24
#   WEAVIATE_API_KEY:  openssl rand -hex 32
#   SANDBOX_API_KEY:   openssl rand -hex 32
#
# =============================================================================


# =============================================================================
# 一、Dify 版本
# =============================================================================

# [可选] Dify 镜像版本号，留空则使用脚本内置默认版本
# 查看可用版本：https://hub.docker.com/r/langgenius/dify-api/tags
DIFY_VERSION=0.15.3


# =============================================================================
# 二、核心密钥（[必填]，请务必在首次部署前生成强随机值）
# =============================================================================

# Dify 后端密钥，用于加密会话 Token、密码哈希等
# ⚠️  首次部署后切勿更改，否则所有用户 Token 失效，所有加密数据不可用
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# 示例：将下方注释取消，并替换为 `openssl rand -hex 32` 的输出
# SECRET_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2


# =============================================================================
# 三、PostgreSQL 数据库
# =============================================================================

# [必填] 数据库密码
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# [可选] 数据库用户名，默认 dify
POSTGRES_USER=dify

# [可选] 数据库名称，默认 dify
POSTGRES_DB=dify

# [可选] 数据库主机
#   - 单机部署：使用容器名 db（默认）
#   - 多机部署：改为基础设施节点的 IP 或 DNS 名称
POSTGRES_HOST=db

# [可选] 数据库端口，默认 5432
POSTGRES_PORT=5432

# --- PostgreSQL 性能调优（按服务器内存酌情调整）---

# 最大连接数（建议 = CPU 核数 × 4，最大 500）
POSTGRES_MAX_CONNECTIONS=200

# 共享缓冲区（建议 = 总内存的 25%）
POSTGRES_SHARED_BUFFERS=512MB

# 单个查询工作内存
POSTGRES_WORK_MEM=16MB

# 维护操作内存（VACUUM/CREATE INDEX）
POSTGRES_MAINTENANCE_WORK_MEM=64MB

# 有效缓存大小（建议 = 总内存的 75%，供查询规划器参考）
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB


# =============================================================================
# 四、Redis
# =============================================================================

# [必填] Redis 密码
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# [可选] Redis 主机
#   - 单机部署：使用容器名 redis（默认）
#   - 多机部署：改为基础设施节点的 IP 或 DNS 名称
REDIS_HOST=redis

# [可选] Redis 端口，默认 6379
REDIS_PORT=6379

# [可选] Redis 最大内存限制（建议 512mb ~ 2gb）
REDIS_MAX_MEMORY=512mb

# [可选] Celery Broker 是否使用 SSL 连接 Redis（托管 Redis 通常需要）
BROKER_USE_SSL=false


# =============================================================================
# 五、Weaviate 向量数据库
# =============================================================================

# [必填] Weaviate API 密钥
WEAVIATE_API_KEY=CHANGE_ME_use_openssl_rand_hex_32

# [可选] Weaviate 主机
#   - 单机部署：使用容器名 weaviate（默认）
#   - 多机部署：改为基础设施节点的 IP 或 DNS 名称
WEAVIATE_HOST=weaviate

# [可选] 向量数据库类型（weaviate / qdrant / milvus / pgvector）
VECTOR_STORE=weaviate


# =============================================================================
# 六、Sandbox 代码执行服务
# =============================================================================

# [必填] Sandbox 接口密钥
SANDBOX_API_KEY=CHANGE_ME_use_openssl_rand_hex_32

# [可选] Sandbox 主机（单机默认 sandbox，多机填基础设施节点 IP）
SANDBOX_HOST=sandbox

# [可选] 代码执行超时（秒）
SANDBOX_WORKER_TIMEOUT=15

# [可选] 是否允许 sandbox 访问外网（生产建议 false）
SANDBOX_ENABLE_NETWORK=false

# [可选] Sandbox 出站代理（由 ssrf_proxy 容器提供）
SSRF_HTTP_PROXY=http://ssrf_proxy:3128
SSRF_HTTPS_PROXY=http://ssrf_proxy:3128


# =============================================================================
# 七、文件存储
# =============================================================================

# [可选] 存储驱动：local（默认）/ s3 / azure-blob / google-storage
# 生产多机部署时，强烈建议使用 s3 或兼容对象存储，确保所有 API/Worker 节点共享同一存储
STORAGE_TYPE=local

# --- 使用 S3 或兼容对象存储时填写（MinIO / 阿里云 OSS / 腾讯云 COS 均兼容）---
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BUCKET_NAME=my-dify-bucket
# S3_ACCESS_KEY=your-access-key-id
# S3_SECRET_KEY=your-secret-access-key
# S3_REGION=us-east-1


# =============================================================================
# 八、对外访问 URL（nginx 或负载均衡器的公网/内网地址）
# =============================================================================

# [可选] 控制台 Web 前端 URL（浏览器访问 Dify 控制台的地址）
# 示例：https://dify.example.com
CONSOLE_WEB_URL=

# [可选] 控制台 API URL（控制台前端调用 API 的地址，通常与 CONSOLE_WEB_URL 相同）
CONSOLE_API_URL=

# [可选] 服务 API URL（外部应用调用 Dify API 的地址）
SERVICE_API_URL=

# [可选] 应用 Web URL（Dify 应用页面的基础 URL）
APP_WEB_URL=

# [可选] App API URL（应用前端调用 API 的地址）
APP_API_URL=


# =============================================================================
# 九、Nginx
# =============================================================================

# [可选] HTTP 监听端口，默认 80
NGINX_HTTP_PORT=80

# [可选] HTTPS 监听端口，默认 443
NGINX_HTTPS_PORT=443

# [可选] Nginx server_name（填写域名，多个用空格分隔）
# 示例：NGINX_SERVER_NAME=dify.example.com
NGINX_SERVER_NAME=_

# [可选] 自定义 nginx 配置目录（包含 dify.conf 等文件）
# 默认为脚本自动生成到 .compose/nginx/
# NGINX_CONF_DIR=./nginx

# [可选] SSL 证书目录（需包含 fullchain.pem 和 privkey.pem）
# NGINX_SSL_DIR=./ssl

# [可选] nginx 日志目录
NGINX_LOG_DIR=./logs/nginx

# --- 多机 API 节点负载均衡 ---
# 当 API 服务分布在多台机器时，在启动 nginx 节点时通过 --nginx-api-upstreams 参数传入，
# 或在此处以空格分隔的方式列出（脚本会优先使用命令行参数）：
#
# 示例（3 台 API 机器）：
#   --nginx-api-upstreams "192.168.1.11:5001 192.168.1.12:5001 192.168.1.13:5001"
#
# 如果在同一台机器上通过 docker compose scale api=N 扩容，nginx 会通过容器名 api
# 自动发现所有副本，无需手动指定。


# =============================================================================
# 十、API / Worker 节点绑定（仅在直接暴露 API 端口时使用）
# =============================================================================

# [可选] API 绑定 IP（127.0.0.1 = 仅本机访问；0.0.0.0 = 所有网卡）
# 多机部署通过 nginx 代理时，建议保持 127.0.0.1 或注释掉端口映射
API_BIND_HOST=127.0.0.1

# [可选] API 对外端口（仅单副本时有效）
API_PORT=5001


# =============================================================================
# 十一、应用日志
# =============================================================================

# [可选] 日志级别：DEBUG / INFO / WARNING / ERROR（生产建议 INFO）
LOG_LEVEL=INFO

# [可选] 开启调试模式（生产务必设置为 false）
DEBUG=false


# =============================================================================
# 十二、Celery Worker 调优
# =============================================================================

# [可选] Worker 并发数，留空则由 Celery 自动根据 CPU 数决定
CELERY_WORKER_AMOUNT=

# [可选] 是否开启 Celery Autoscale
CELERY_AUTO_SCALE=false

# [可选] Autoscale 最大 / 最小 Worker 数
CELERY_MAX_WORKERS=4
CELERY_MIN_WORKERS=1


# =============================================================================
# 十三、邮件服务（可选）
# =============================================================================

# 邮件服务类型：resend / smtp（留空则禁用邮件功能）
MAIL_TYPE=resend

# Resend API Key（https://resend.com）
RESEND_API_KEY=

# 发件人地址（示例：Dify <noreply@example.com>）
MAIL_DEFAULT_SEND_FROM=


# =============================================================================
# 十四、文件上传限制
# =============================================================================

# [可选] 单文件上传大小上限（MB）
UPLOAD_FILE_SIZE_LIMIT=15

# [可选] 单次批量上传文件数上限
UPLOAD_FILE_BATCH_LIMIT=5

# [可选] 图片上传大小上限（MB）
UPLOAD_IMAGE_FILE_SIZE_LIMIT=10


# =============================================================================
# 十五、扩容场景示例注释
# =============================================================================
#
# 场景 A：单机 all-in-one（开发/测试）
# ─────────────────────────────────────
#   bash dify_deploy.sh up
#
# 场景 B：两机部署
#   机器 1（基础设施）：POSTGRES_HOST=localhost, REDIS_HOST=localhost, ...
#   机器 2（应用层）  ：POSTGRES_HOST=192.168.1.10, REDIS_HOST=192.168.1.10, ...
#   机器 2 启动命令：
#     bash dify_deploy.sh --role api,worker,web,nginx up
#
# 场景 C：三机生产部署 + API 多副本
#   机器 A（infrastructure）：bash dify_deploy.sh --role infrastructure up
#   机器 B（api+worker x3）：
#     bash dify_deploy.sh --role api,worker --api-replicas 3 up
#   机器 C（web+nginx）：
#     bash dify_deploy.sh --role web,nginx \
#         --nginx-api-upstreams "192.168.1.11:5001 192.168.1.12:5001 192.168.1.13:5001" \
#         up
#
# 场景 D：使用云对象存储（生产多机必须）
#   STORAGE_TYPE=s3
#   S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
#   S3_BUCKET_NAME=my-dify-bucket
#   S3_ACCESS_KEY=...
#   S3_SECRET_KEY=...
#   S3_REGION=cn-hangzhou
